# Base URL of the local DSA API. The Next.js client calls this from the browser,
# so it must be reachable from whatever device is rendering the app:
#   - web app in a browser on this machine: 127.0.0.1 is fine
#   - phone or tablet on the same wifi:     use this Mac's LAN IP instead
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# /api/generate is the only call that reaches an LLM, so it needs a much longer
# deadline than the default 30s. It must stay above the server's per-tier
# budget (CHAIN_TIMEOUT_MS, default 200s) or the browser gives up while the
# server is still writing. Measured: opencode takes ~126s for a binary search.
NEXT_PUBLIC_GENERATE_TIMEOUT_MS=240000
# Everything else (catalogue, health, action, hint) is fast.
NEXT_PUBLIC_API_TIMEOUT_MS=30000
