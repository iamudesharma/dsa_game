# ---- Tier 1: opencode-go (direct HTTPS to opencode.ai, the primary provider) ----
# The first tier the chain tries: a plain `POST {base}/chat/completions` with
# `Authorization: Bearer $OPENCODE_API_KEY`. No local gateway, no `opencode serve`,
# nothing to keep running locally.
#
# Get a key from the OpenCode dashboard. It falls back to OPENCODE_API_KEY, which
# is the same variable the opencode CLI/serve path reads, so if you already export
# it you can leave this blank.
OPENCODE_GO_API_KEY=
# Leave OPENCODE_GO_ENABLED=0 to force the chain past this tier.
OPENCODE_GO_ENABLED=1
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# REQUIRED by opencode-go alongside the key (https://opencode.ai/docs/go/).
# It wants a client-specific user-agent and a stable x-opencode-session per
# conversation; without the session header the API answers 400 "Request is
# missing x-opencode-session and cannot be routed efficiently".
OPENCODE_GO_USER_AGENT=dsa-game/0.1.0
# Leave blank: one session id per generate() call, which is the right default
# because each GameSpec is its own conversation. Pin only when several calls
# genuinely belong to one conversation and should share prompt caching.
OPENCODE_GO_SESSION=
# Leave BLANK to pick the cheapest/fastest model the endpoint is actually serving,
# read live from `GET {base}/models` (that endpoint is public and free — no key
# needed; run `curl $OPENCODE_GO_BASE_URL/models` to see the current list). A
# hardcoded id is a guess that rots, so the code resolves it at runtime and caches
# it. Pin a value here to override, e.g. OPENCODE_GO_MODEL=glm-5.3-flash
OPENCODE_GO_MODEL=
# A GameSpec took ~126s end to end, so keep this at or below CHAIN_TIMEOUT_MS
# (the chain aborts first otherwise and the tier never finishes).
OPENCODE_GO_TIMEOUT_MS=180000
OPENCODE_GO_TEMPERATURE=0.9
# A GameSpec is a long strict JSON object; too low and the reply is truncated
# mid-JSON, which the provider reports as a token limit rather than a schema bug.
OPENCODE_GO_MAX_TOKENS=16000

# ---- Tier 2: opencode (local `opencode serve` gateway) ----
# opencode serves an HTTP API on :4096 but protects it with HTTP Basic auth
# (`opencode:<password>`). The password is printed by `opencode serve` on
# startup, and is NOT the one in ~/.config/opencode/service.json. Grab it with:
#   grep -oE "password [A-Za-z0-9_-]+" /tmp/opencode-serve.log
# Leave blank if opencode is not running -- the chain falls through cleanly.
OPENCODE_PASSWORD=
# The model must be selected at POST /api/session; the /prompt body ignores it.
# space-bunny-free is the only tier that answered on the account this was built
# on -- every paid opencode model returned 402 "Insufficient account funds".
# Swap this once the account has funds.
OPENCODE_MODEL=opencode/space-bunny-free
OPENCODE_BASE_URL=http://127.0.0.1:4096
# A GameSpec is a few thousand prompt tokens plus a long JSON completion, and
# measured ~126s end-to-end. The chain allows 200s per tier; raise it if your
# model is slower.
CHAIN_TIMEOUT_MS=200000
OPENCODE_TIMEOUT_MS=180000
OPENCODE_ENABLED=1
# opencode loads project agents from .opencode/agents/, not from agents/.
# A symlink is already in place; unset this to use the server's default agent.
OPENCODE_AGENT=dsa-game-gen

# ---- Tier 3: OpenRouter fallback ----
# Leave blank to keep tier 3 dormant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Tier 4: local Qwen2.5-0.5B-Instruct via llama.cpp (offline last resort) ----
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081
LOCAL_LLM_ENABLED=1

# ---- Tier 5: template (zero I/O, always available) ----
# Nothing to configure. This is the guarantee the app is always playable.

# ---- Laya sidecar (local decision engine) ----
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_ENABLED=1
LAYA_MODEL=typed-decisions

# ---- Service ----
PORT=8787
API_HOST=127.0.0.1

# ---- Accounts (SQLite, no external service) ----
# Local file for users, resumes, targets, kits, and progress sync.
DSA_DB_PATH=run/dsa.db
# Set INTERVIEW_TRANSPORT=0 to force the deterministic question template
# (no model call, same guarantee as the game's template tier).
